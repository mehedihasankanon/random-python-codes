   "source": [
    "import cpuinfo\n",
    "\n",
    "cpu_name = cpuinfo.get_cpu_info()['brand_raw']\n",
    "print(f\"CPU Name: {cpu_name}\")\n",
    "\n",
    "import torch\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU Name: {torch.cuda.get_device_name(0)}\")\n",
    "else:\n",
    "    print(\"No CUDA GPU found.\")\n",
    "\n"
   ]
  }
 ],
